{
  "version": "0.3",
  "scripts": [
    {
      "documentation": {
        "command": "run-tests",
        "description": "Build mu-identifier, run the full integration test suite, and tear down.",
        "arguments": []
      },
      "environment": {
        "interactive": true,
        "join_networks": true,
        "script": "run-tests/run.sh"
      },
      "mounts": {
        "app": "/mu-project",
        "host": "/usr/bin/host"
      },
      "permissions": {
        "host": [
          {
            "name": "build",
            "comment": "Build test images",
            "command": "^docker compose build$"
          },
          {
            "name": "start-identifier",
            "comment": "Start or restart the identifier service",
            "command": "^docker compose up -d identifier( --force-recreate)?$"
          },
          {
            "name": "run-test-specs",
            "comment": "Run a mocha test spec by name",
            "command": "^docker compose run --rm --use-aliases -e TEST_SPEC=cases/[0-9a-z-]+\\.js tests$"
          },
          {
            "name": "run-revocation-spec",
            "comment": "Run the session revocation spec with captured session cookies",
            "command": "^docker compose run --rm --use-aliases -e TEST_SPEC=cases/09-session-revocation\\.js( -e [A-Z_]+=[-a-zA-Z0-9._=:/]+)* tests$"
          },
          {
            "name": "capture-session",
            "comment": "Establish a session and capture its cookie for revocation tests",
            "command": "^docker compose run --rm --use-aliases --no-deps -e GROUPS=\\S+ tests node /tests/capture-session\\.js$"
          },
          {
            "name": "revocation-scripts",
            "comment": "Invoke session revocation scripts on the identifier via mu-cli",
            "command": "^(works|wo|mu) script identifier (revoke-session|revoke-allowed-groups-string)( \\S+)*$"
          },
          {
            "name": "teardown",
            "comment": "Tear down the test stack",
            "command": "^docker compose down$"
          }
        ]
      }
    }
  ]
}
