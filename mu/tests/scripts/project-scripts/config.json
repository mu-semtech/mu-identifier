{
  "version": "0.3",
  "scripts": [
    {
      "documentation": {
        "command": "run-tests",
        "description": "Build mu-identifier, run the full integration test suite, and tear down.",
        "arguments": []
      },
      "environment": {
        "interactive": true,
        "join_networks": true,
        "script": "run-tests/run.sh"
      },
      "mounts": {
        "app": "/mu-project",
        "host": "/usr/bin/host"
      },
      "permissions": {
        "host": [
          {
            "name": "build",
            "comment": "Build test images",
            "command": "^docker compose build$"
          },
          {
            "name": "start-identifier",
            "comment": "Start identifier with optional compose overrides",
            "command": "^docker compose( -f \\S+)* up -d identifier( --force-recreate)?$"
          },
          {
            "name": "run-test-specs",
            "comment": "Run mocha test specs with optional compose overrides and env vars",
            "command": "^docker compose( -f \\S+)* run --rm --use-aliases( -e \\S+)* tests$"
          },
          {
            "name": "capture-session",
            "comment": "Establish a session and capture its cookie for revocation tests",
            "command": "^docker compose run --rm --use-aliases --no-deps -e GROUPS=\\S+ tests node /tests/capture-session\\.js$"
          },
          {
            "name": "revocation-scripts",
            "comment": "Invoke session revocation scripts on the identifier",
            "command": "^docker compose run --rm --entrypoint /app/scripts/(revoke-session|revoke-allowed-groups-string)/run\\.sh identifier( \\S+)*$"
          },
          {
            "name": "teardown",
            "comment": "Tear down the test stack",
            "command": "^docker compose down$"
          }
        ]
      }
    }
  ]
}
