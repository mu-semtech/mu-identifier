{
  "version": "0.3",
  "scripts": [
    {
      "documentation": {
        "command": "revoke-session",
        "description": "Revoke a session URI.  Strategy is one of clear_mu_auth_allowed_groups (default) or clear_mu_session_id.",
        "arguments": ["session-uri", "strategy", "persist-seconds"]
      },
      "environment": {
        "interactive": false,
        "join_networks": true,
        "script": "revoke-session/run.sh"
      }
    },
    {
      "documentation": {
        "command": "revoke-allowed-groups-string",
        "description": "Revoke all sessions holding a specific allowed-groups string.  Strategy is one of clear_mu_auth_allowed_groups (default) or clear_mu_session_id.",
        "arguments": ["allowed-groups-string", "strategy", "persist-seconds"]
      },
      "environment": {
        "interactive": false,
        "join_networks": true,
        "script": "revoke-allowed-groups-string/run.sh"
      }
    }
    ,{
      "documentation": {
        "command": "list-revocations",
        "description": "List all session IDs and allowed-groups strings currently tracked for revocation",
        "arguments": []
      },
      "environment": {
        "interactive": false,
        "join_networks": true,
        "script": "list-revocations/run.sh"
      }
    }
  ]
}
